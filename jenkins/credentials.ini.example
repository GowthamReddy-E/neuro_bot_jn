# Example configuration for multiple Jenkins instances

# =================================================================
# EXAMPLE 1: Single Jenkins Instance
# =================================================================

[default]
username = your_jenkins_username
token = your_jenkins_api_token

# =================================================================
# EXAMPLE 2: Multiple Jenkins Instances
# =================================================================

# Primary Jenkins server (default)
[default]
username = primary_user
token = primary_api_token_123

# Secondary Jenkins server for team A
[team_a_jenkins]
username = team_a_user
token = team_a_api_token_456

# Production Jenkins server
[production]
username = prod_user
token = prod_api_token_789

# External Jenkins server (different company/department)
[external]
username = external_user
token = external_api_token_abc

# =================================================================
# EXAMPLE 3: Per-Environment Setup
# =================================================================

[development]
username = dev_jenkins_user
token = dev_token_123

[staging]
username = staging_jenkins_user
token = staging_token_456

[production]
username = prod_jenkins_user
token = prod_token_789

# =================================================================
# NOTES:
# - Use Jenkins API tokens, not passwords
# - Get tokens from: Jenkins → Your Profile → Configure → API Token
# - Each section name can be referenced in job_config.ini
# - If no 'instance' is specified for a job, 'default' is used
# =================================================================