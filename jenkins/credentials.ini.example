[ftd-asa]
username = your_ftd_asa_username
token = your_ftd_asa_api_token

[ssp]
username = your_ssp_username
token = your_ssp_api_token

[build]
username = your_build_username
token = your_build_api_token

[service]
username = your_service_username
token = your_service_api_token

# Optional fallback section used when a mapped instance is missing.
[default]
username = your_default_username
token = your_default_api_token