# Copy to .env.local for local-only secrets.
# This file is git-ignored.

WEBEX_BOT_TOKEN=your_webex_bot_token
WEBEX_BOT_PERSON_ID=your_webex_bot_person_id

# Per-instance Jenkins credentials (derived from job_config.ini instance names)
JENKINS_FTD_ASA_USERNAME=your_ftd_asa_user
JENKINS_FTD_ASA_TOKEN=your_ftd_asa_token

JENKINS_SSP_USERNAME=your_ssp_user
JENKINS_SSP_TOKEN=your_ssp_token

JENKINS_BUILD_USERNAME=your_build_user
JENKINS_BUILD_TOKEN=your_build_token

JENKINS_SERVICE_USERNAME=your_service_user
JENKINS_SERVICE_TOKEN=your_service_token

# Optional alternatives for credentials.ini generation
# JENKINS_CREDENTIALS_INI="[ftd-asa]\nusername = user\ntoken = token\n"
# JENKINS_CREDENTIALS_INI_BASE64=<base64-encoded-credentials-ini>
